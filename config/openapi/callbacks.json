{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "AliyunProxy cloud SMS callbacks",
    "version": "2026-11-14"
  },
  "servers": [
    {
      "url": "../.."
    }
  ],
  "paths": {
    "/sms/callback/sign_reports": {
      "post": {
        "summary": "Receive cloud sign reports",
        "description": "Server-to-server JSON push: no browser cookie or CSRF token required. Query credential authentication is optional: unset or blank aliyun_sms_callback_token disables this check. When configured, verify callback_token before querying or changing business records; a body field or browser login cannot replace it. Missing/incorrect credentials return 401; a configured credential shorter than 32 bytes returns 503. Successful processing preserves the vendor acknowledgement.",
        "security": [
          {},
          {
            "callbackCredential": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "sign_name",
                    "sign_status"
                  ],
                  "properties": {
                    "sign_name": {
                      "type": "string"
                    },
                    "sign_status": {
                      "type": "string",
                      "enum": [
                        "approving",
                        "approved",
                        "rejected"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully received",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackAcknowledgement"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Callback credential missing or incorrect while authentication is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Configured server callback credential is too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Check callback endpoint connectivity",
        "description": "Returns the vendor JSON acknowledgement without querying or changing business records. Uses the same optional query credential setting as POST; no browser authentication or CSRF token is required.",
        "security": [
          {},
          {
            "callbackCredential": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully received",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackAcknowledgement"
                }
              }
            }
          },
          "401": {
            "description": "Callback credential missing or incorrect while authentication is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Configured server callback credential is too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
