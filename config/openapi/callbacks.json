  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "CallbackAcknowledgement": {
        "type": "object",
        "required": [
          "code",
          "msg"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "const": 0
          },
          "msg": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "callbackCredential": {
        "type": "apiKey",
        "in": "query",
        "name": "callback_token",
        "description": "Optional random shared callback credential configured by the operator; not a vendor digital signature. Enforced only when aliyun_sms_callback_token is nonblank. Configure the full HTTPS callback URL in the cloud console."
      }
    }
  }
