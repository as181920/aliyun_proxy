{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "AliyunProxy CAPTCHA browser API",
    "version": "2026-11-08"
  },
  "servers": [
    {
      "url": ".."
    }
  ],
  "paths": {
    "/captcha/challenges/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "locale",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Optional parent page locale for iframe verification. If absent, the page uses its own Accept-Language/default locale selection."
        }
      ],
      "get": {
        "summary": "Open the shared CAPTCHA page",
        "description": "Browser challenge UI without Auth models. Cookie-bound challenges require their original browser. Cross-origin login attempts may be framed only by their validated client origin; the client key is read from the iframe fragment, cleared immediately, and required for verification. Activity challenges first visit the authorized AntiCheat browser-binding entry.",
        "responses": {
          "200": {
            "description": "HTML CAPTCHA page"
          },
          "403": {
            "description": "Browser binding mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Expired challenge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "aliyunProxyCaptchaChallengeShow",
        "security": []
      },
      "patch": {
        "summary": "Verify the opaque SDK ticket",
        "description": "Requires the bound browser session and Rails CSRF token. Only strict T001/true plus the matching CertifyId marks the challenge verified. This does not consume business authorization, sign in, or issue rewards. redirect_url points to the server-bound consumer callback or original activity page.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "captcha"
                ],
                "properties": {
                  "captcha": {
                    "type": "object",
                    "required": [
                      "verify_param"
                    ],
                    "properties": {
                      "verify_param": {
                        "type": "string",
                        "maxLength": 16384
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified; navigate to the consumer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "redirect_url"
                  ],
                  "properties": {
                    "redirect_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Browser binding mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Expired challenge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Verification failed or consumed; CSRF failures follow Rails handling",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Provider, configuration or storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Captcha-Client-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "description": "Cross-origin login only. Must match this challenge; this explicit credential replaces cookie CSRF for this PATCH only. Cookie-bound challenges still require browser matching and CSRF."
          }
        ],
        "operationId": "aliyunProxyCaptchaChallengeVerify",
        "security": []
      }
    },
    "/captcha/login_verification": {
      "get": {
        "summary": "Notify a same-origin login iframe parent after human verification or cancellation",
        "description": "No Auth user lookup, credential issuance or final proof consumption. The original login POST still verifies credentials. Cross-origin H5 client challenges notify their configured parent directly.",
        "parameters": [
          {
            "name": "captcha_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML postMessage notification"
          },
          "403": {
            "description": "Browser, purpose or verification mismatch; minimal HTML or structured JSON error"
          },
          "410": {
            "description": "Expired challenge; minimal HTML or structured JSON error"
          },
          "503": {
            "description": "Storage unavailable; minimal HTML or structured JSON error"
          }
        },
        "operationId": "aliyunProxyCaptchaLoginVerificationShow",
        "security": []
      }
    }
  }
}
