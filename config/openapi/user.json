{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "AliyunProxy user PNVS API",
    "version": "2026-11-13"
  },
  "servers": [
    {
      "url": "../.."
    }
  ],
  "paths": {
    "/pnvs/auth_tokens": {
      "post": {
        "summary": "Create PNVS authentication token",
        "description": "Explicit code/token authentication is validated without creating a browser login session. Cookie/session requests retain Rails CSRF, including JSON requests. Invalid explicit credentials never fall back to the browser identity.",
        "security": [
          {
            "userCredential": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "auth_token": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "origin": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing PNVS response payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pnvs/phones": {
      "post": {
        "summary": "Resolve and bind the current user phone",
        "description": "Explicit code/token authentication is validated without creating a browser login session. Cookie/session requests retain Rails CSRF, including JSON requests. Invalid explicit credentials never fall back to the browser identity.",
        "security": [
          {
            "userCredential": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "object",
                    "properties": {
                      "sp_token": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved phone belonging to the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "phone"
                  ],
                  "properties": {
                    "phone": {
                      "type": "object",
                      "required": [
                        "user_id",
                        "number"
                      ],
                      "properties": {
                        "user_id": {
                          "type": "integer"
                        },
                        "number": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "userCredential": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "PlainUserToken <token> or one-use PlainUserCode <code>. Basic denotes a browser session and requires CSRF."
      }
    }
  }
}
