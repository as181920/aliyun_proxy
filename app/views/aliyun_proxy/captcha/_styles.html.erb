<style nonce="<%= content_security_policy_nonce %>" data-turbo-track="dynamic">
  .acv-page, .acv-page *, .acv-page *::before, .acv-page *::after { box-sizing: border-box; }
  .acv-page { min-height: 100vh; min-height: 100svh; margin: 0; display: flex; color: #393a36; background: radial-gradient(ellipse at 50% 34%, #fff6ed 0, transparent 60%), #fff; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.5; -webkit-font-smoothing: antialiased; }
  .acv-page::before { content: ""; position: fixed; top: 48%; left: 50%; width: min(84vw, 880px); aspect-ratio: 1; border: 1px solid #f8f1ea; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
  .acv-main { position: relative; width: min(420px, 100%); margin: auto; padding: 48px 28px; text-align: center; }
  .acv-art { width: 136px; margin: 0 auto 24px; }
  .acv-art svg { display: block; width: 100%; height: auto; }
  .acv-main h1 { margin: 0; font-size: 28px; line-height: 1.4; font-weight: 600; letter-spacing: .025em; }
  .acv-description { margin: 10px 0 34px; color: #92928b; font-size: 14px; }
  .acv-workspace { width: 100%; }
  .acv-workspace h2 { margin: 0 0 20px; font-size: 16px; font-weight: 400; line-height: 1.8; color: #85877f; }
  .acv-submit { width: 100%; min-height: 54px; display: flex; align-items: center; justify-content: center; gap: 14px; border: 0; border-radius: 14px; background: #f1d7c1; color: #654c37; font: inherit; font-size: 16px; font-weight: 500; cursor: pointer; transition: background .15s, box-shadow .15s; }
  .acv-submit::after { content: "→"; font-size: 20px; line-height: 1; }
  .acv-submit:hover { background: #eac9ae; box-shadow: 0 6px 20px #d4ae8b24; }
  .acv-submit:disabled { background: #f7f2ec; color: #b3a99d; cursor: wait; box-shadow: none; }
  .acv-submit:focus-visible, .acv-back:focus-visible { outline: 3px solid #ebcdb4; outline-offset: 4px; }
  .acv-status { min-height: 22px; margin: 12px 0 0; font-size: 13px; line-height: 1.7; color: #8c9390; }
  .acv-back { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 6px; color: #989b94; font-size: 13px; text-decoration: none; }
  .acv-back:hover { color: #856a53; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 480px) { .acv-main { padding: 36px 30px; } .acv-art { width: 120px; margin-bottom: 20px; } .acv-main h1 { font-size: 26px; } .acv-description { margin-bottom: 30px; } }
  @media (prefers-reduced-motion: reduce) { .acv-submit { transition: none; } }
</style>
