<div id="captcha-element"></div>
<button id="captcha-trigger" type="button" hidden></button>
<button id="captcha-button" type="button" class="acv-submit" disabled><%= t("aliyun_proxy.captcha.loading") %></button>
<p id="captcha-status" class="acv-status" role="status" aria-live="polite"></p>
<%= link_to @cancel_url, id: "captcha-cancel", class: "acv-back" do %><%= t("aliyun_proxy.captcha.cancel") %><% end %>
<script nonce="<%= content_security_policy_nonce %>">
(() => {
  const button = document.getElementById('captcha-button');
  const status = document.getElementById('captcha-status');
  const text = <%= raw json_escape({ loading: t("aliyun_proxy.captcha.loading"), verifying: t("aliyun_proxy.captcha.verifying"), retry: t("aliyun_proxy.captcha.retry"), unavailable: t("aliyun_proxy.captcha.unavailable"), failed: t("aliyun_proxy.captcha.failed"), checking: t("aliyun_proxy.captcha.checking") }.to_json) %>;
  const clientOrigin = <%= raw json_escape(@client_origin.to_json) %>;
  const challengeId = <%= raw json_escape(@challenge.id.to_json) %>;
  const clientKey = clientOrigin ? new URLSearchParams(window.location.hash.slice(1)).get('captcha_client_key') : null;
  if (clientKey) window.history.replaceState(window.history.state, '', window.location.pathname + window.location.search);
  const notify = (type) => window.parent.postMessage({ type, challenge: challengeId }, clientOrigin);
  if (clientOrigin) document.getElementById('captcha-cancel').onclick = (event) => {
    event.preventDefault(); notify('aliyun_proxy:captcha_cancelled');
  };
  const options = <%= raw json_escape(@client_options.to_json) %>;
  window.AliyunCaptchaConfig = { region: 'cn', prefix: <%= raw json_escape(@prefix.to_json) %> };
  let disposed = false, submitting = false;
  let captcha, script;
  const pendingRequest = new AbortController();
  const active = () => !disposed && button.isConnected;
  const cleanup = () => {
    if (disposed) return;
    disposed = true;
    button.onclick = null;
    pendingRequest.abort();
    captcha?.hide?.();
    if (script) {
      script.onload = script.onerror = null;
      script.remove();
    }
    document.removeEventListener('turbo:before-cache', cleanup);
    document.removeEventListener('turbo:before-render', cleanup);
  };
  document.addEventListener('turbo:before-cache', cleanup);
  document.addEventListener('turbo:before-render', cleanup);

  const retry = (message) => {
    if (!active()) return;
    button.disabled = false;
    button.textContent = text.retry;
    status.textContent = message;
  };
  const verify = () => {
    if (!active() || button.disabled) return;
    if (!captcha) { loadSdk(); return; }
    button.disabled = true;
    button.textContent = text.verifying;
    status.textContent = '';
    try {
      captcha.show();
      if (typeof captcha.startTracelessVerification === 'function') captcha.startTracelessVerification();
    } catch (_) {
      retry(text.unavailable);
    }
  };
  button.onclick = verify;

  const initialize = () => {
    if (!active()) return;
    window.initAliyunCaptcha({
      ...options, mode: 'popup', element: '#captcha-element', button: '#captcha-trigger',
      getInstance: (instance) => {
        if (!active()) { instance.hide?.(); return; }
        captcha = instance;
        queueMicrotask(() => {
          if (!active() || captcha !== instance) return;
          button.disabled = false;
          verify();
        });
      },
      fail: () => { if (!submitting) retry(text.failed); },
      onError: () => { if (!submitting) { captcha = null; retry(text.unavailable); } },
      onClose: (reason) => { if (reason === 'userDismiss' && !submitting) retry(''); },
      success: async (parameter) => {
        if (!active() || submitting) return;
        submitting = true;
        button.disabled = true;
        status.textContent = text.checking;
        try {
          const response = await fetch(<%= raw json_escape(captcha_verification_path.to_json) %>, {
            method: 'PATCH', credentials: 'same-origin', signal: pendingRequest.signal,
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, ...(clientKey ? { 'X-Captcha-Client-Key': clientKey } : {}) },
            body: JSON.stringify({ captcha: { verify_param: parameter } })
          });
          const result = await response.json();
          if (!active()) return;
          if (response.ok && result.redirect_url) {
            if (clientOrigin) notify('aliyun_proxy:captcha_verified');
            else window.location.replace(result.redirect_url);
            return;
          }
          retry(result.error?.message || text.failed);
        } catch (_) {
          if (!active()) return;
          retry(text.unavailable);
        }
        submitting = false;
        captcha?.hide?.();
        captcha = null;
      }
    });
  };
  const loadSdk = () => {
    if (!active()) return;
    button.disabled = true;
    button.textContent = text.loading;
    status.textContent = '';
    if (typeof window.initAliyunCaptcha === 'function') {
      try { initialize(); } catch (_) { captcha = null; retry(text.unavailable); }
      return;
    }
    script?.remove();
    script = document.createElement('script');
    script.src = 'https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js';
    script.onerror = () => retry(text.unavailable);
    script.onload = () => { if (active()) loadSdk(); };
    document.head.appendChild(script);
  };
  loadSdk();
})();
</script>
